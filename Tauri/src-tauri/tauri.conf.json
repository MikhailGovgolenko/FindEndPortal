{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "findendportal",
  "version": "1.6.0",
  "identifier": "FindEndPortal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
      "windows": [
        {
          "title": "FindEndPortal",
          "width": 560,
          "height": 420,
          "resizable": true,
          "transparent": true
        }
      ],
      "security": {
        "csp": null
      }
    },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
